{
  "name": "melody-bounce",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "melody-bounce": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./audio": "./dist/core/audio/index.js",
    "./midi": "./dist/core/midi.js",
    "./songs": "./dist/core/songs/index.js",
    "./job": "./dist/core/job.js",
    "./timing": "./dist/core/timing.js",
    "./render": "./dist/render/index.js",
    "./compositions": "./dist/render/compositions/index.js",
    "./audio/browser": "./dist/core/audio/browser.js"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "LICENSE-NOTES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "golden:generate": "python -B scripts/generate-golden.py",
    "prepack": "npm run build",
    "test:audio-files": "npm run build && node scripts/audio-smoke.mjs",
    "golden:audio:generate": "python -B scripts/generate-audio-golden.py",
    "compositions:sync": "node scripts/adapt-compositions.mjs --write",
    "player": "vite --config examples/player/vite.config.ts",
    "player:build": "vite build --config examples/player/vite.config.ts",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/player": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@tonejs/midi": "2.0.28",
    "fft.js": "4.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luoy16002-svg/melody-bounce.git"
  },
  "homepage": "https://github.com/luoy16002-svg/melody-bounce#readme",
  "bugs": {
    "url": "https://github.com/luoy16002-svg/melody-bounce/issues"
  },
  "keywords": [
    "physics",
    "simulation",
    "music",
    "midi",
    "video",
    "remotion",
    "satisfying",
    "bouncing-ball"
  ],
  "description": "Physics videos where every collision plays the next note of a song."
}
